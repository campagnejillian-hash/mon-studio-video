---
/** Bloc « points forts / points faibles » côte à côte. */
interface Props {
  pros: string[];
  cons: string[];
}
const { pros, cons } = Astro.props;
---
<div class="proscons">
  <div class="col pros">
    <h4>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.5"
          stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Points forts
    </h4>
    <ul>{pros.map((p) => <li>{p}</li>)}</ul>
  </div>
  <div class="col cons">
    <h4>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="2.5"
          stroke-linecap="round"/>
      </svg>
      Points faibles
    </h4>
    <ul>{cons.map((c) => <li>{c}</li>)}</ul>
  </div>
</div>
