---
/**
 * Affiche une note /10 sous forme de 5 étoiles + score chiffré.
 * Technique robuste : on n'utilise QUE le caractère « ★ » (présent dans toutes
 * les polices système) et un remplissage partiel en CSS (largeur en %), ce qui
 * évite les caractères manquants (« tofu ») des demi-étoiles Unicode.
 */
interface Props {
  note: number; // sur 10
  showScore?: boolean;
}
const { note, showScore = true } = Astro.props;
const pct = Math.max(0, Math.min(100, (note / 10) * 100));
---
<span class="rating" aria-label={`Note : ${note} sur 10`}>
  <span class="stars" style={`--pct:${pct}%`} aria-hidden="true">★★★★★</span>
  {showScore && <span class="score">{note.toFixed(1)}<span class="text-mute small">/10</span></span>}
</span>
