---
/** Fil d'Ariane visible (le JSON-LD BreadcrumbList est géré séparément). */
interface Crumb {
  name: string;
  href?: string;
}
interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Fil d'Ariane">
  <ol>
    {crumbs.map((c, i) => (
      <li>
        {c.href && i < crumbs.length - 1 ? (
          <a href={c.href}>{c.name}</a>
        ) : (
          <span aria-current="page">{c.name}</span>
        )}
        {i < crumbs.length - 1 && <span class="sep" aria-hidden="true">›</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0 0 1.25rem;
    padding: 0;
    font-size: 0.86rem;
    color: var(--c-text-mute);
  }
  .breadcrumbs li { display: inline-flex; align-items: center; gap: 0.35rem; margin: 0; }
  .breadcrumbs a { color: var(--c-text-soft); text-decoration: none; }
  .breadcrumbs a:hover { color: var(--c-accent); text-decoration: underline; }
  .breadcrumbs [aria-current='page'] { color: var(--c-text); font-weight: 500; }
  .sep { color: var(--c-border); }
</style>
