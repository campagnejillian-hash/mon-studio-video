---
/** En-tête : logo + navigation principale, accessible et responsive. */
import { SITE, NAV_LINKS } from '../consts';
const path = Astro.url.pathname.replace(/\/$/, '');
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${SITE.name} — accueil`}>
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1"
          stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
      </svg>
      <span>{SITE.name}</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
    <label for="nav-toggle" class="nav-burger" aria-label="Ouvrir le menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="main-nav" aria-label="Navigation principale">
      <ul>
        {NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={path === link.href.replace(/\/$/, '') ? 'page' : undefined}
            >{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--c-border);
    background: color-mix(in srgb, var(--c-bg) 88%, transparent);
    backdrop-filter: saturate(180%) blur(8px);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 60px;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
    color: var(--c-text);
    text-decoration: none;
  }
  .brand svg { color: var(--c-accent); }
  .main-nav ul {
    list-style: none;
    display: flex;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
  }
  .main-nav a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--c-text-soft);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
  }
  .main-nav a:hover { background: var(--c-bg-soft); color: var(--c-text); }
  .main-nav a[aria-current='page'] { color: var(--c-accent); font-weight: 600; }

  .nav-burger { display: none; }

  @media (max-width: 720px) {
    .nav-burger {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 42px;
      height: 42px;
      cursor: pointer;
      border: 1px solid var(--c-border);
      border-radius: var(--radius-sm);
      padding: 0 9px;
    }
    .nav-burger span {
      height: 2px;
      background: var(--c-text);
      border-radius: 2px;
    }
    .main-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--c-bg);
      border-bottom: 1px solid var(--c-border);
      display: none;
      box-shadow: var(--shadow);
    }
    .main-nav ul { flex-direction: column; padding: 0.5rem; gap: 0.15rem; }
    .main-nav a { padding: 0.7rem 0.9rem; }
    .nav-toggle:checked ~ .main-nav { display: block; }
  }
</style>
