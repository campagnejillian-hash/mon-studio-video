---
/**
 * Bouton CTA « Voir le prix sur Amazon ».
 * - JAMAIS de prix numérique en dur.
 * - Liens sortants en rel="nofollow sponsored" + target _blank sécurisé.
 */
interface Props {
  href: string;
  label?: string;
  block?: boolean;
}
const { href, label = 'Voir le prix sur Amazon', block = false } = Astro.props;
---
<a
  class:list={['btn', 'btn-cta', { 'cta-block': block }]}
  href={href}
  target="_blank"
  rel="nofollow sponsored noopener"
  data-affiliate="amazon"
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M3 6h2l2.4 12.3a1 1 0 0 0 1 .7h9.2a1 1 0 0 0 1-.8L21 8H6"
      stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    <circle cx="9" cy="21" r="1.4" fill="currentColor"/>
    <circle cx="18" cy="21" r="1.4" fill="currentColor"/>
  </svg>
  <span>{label}</span>
</a>

<style>
  .cta-block { width: 100%; }
</style>
